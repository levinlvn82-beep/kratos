# TrustLens Environment Configuration Template
# IMPORTANT: Never commit actual keys to version control.
# Set these variables strictly in your cloud host environment settings (Cloudflare / Vercel / Netlify).

# xAI Grok API Key (Keep secret, serverless execution only)
XAI_API_KEY=

# Target Grok Model (e.g. grok-beta, grok-2-latest)
XAI_MODEL=grok-beta

# Emergency Kill-Switch for Off-Device Transmission (true | false)
EXPLAIN_ENABLED=true
